
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background-color: #f4f4f4;
}

/* Header */
header {
    background-color: #2c3e50;
    color: white;
    padding: 40px;
    text-align: center;
}

.profile-container img {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    border: 4px solid white;
    margin-bottom: 15px;
    transition: transform 0.3s ease;
}

/* Profile Hover Effect */
.profile-container img:hover {
    transform: scale(1.1);
}

/* Navigation */
nav {
    background-color: #34495e;
    padding: 12px;
    text-align: center;
}

nav a {
    color: white;
    margin: 0 15px;
    text-decoration: none;
    font-weight: bold;
    transition: color 0.3s;
}

/* Nav Hover */
nav a:hover {
    color: #f1c40f;
}

/* Sections */
section {
    background-color: white;
    margin: 20px;
    padding: 40px;
    border-radius: 8px;
    transition: transform 0.3s, box-shadow 0.3s;
}

/* Section Hover */
section:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}

h2 {
    margin-bottom: 15px;
    color: #2c3e50;
}

/* Skills */
ul {
    padding-left: 20px;
}

/* Projects */
.project-card {
    background-color: #ecf0f1;
    padding: 15px;
    margin-bottom: 15px;
    border-radius: 6px;
    transition: background-color 0.3s, transform 0.3s;
}

/* Project Hover */
.project-card:hover {
    background-color: #dcdde1;
    transform: scale(1.03);
}

/* Footer */
footer {
    background-color: #2c3e50;
    color: white;
    text-align: center;
    padding: 15px;
}
